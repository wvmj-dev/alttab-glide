#: prefs.js:85
msgid "Preview"
msgstr "Prévia"

#: prefs.js:86
msgid "Moves like the real switcher, with the settings below."
msgstr "Move-se como o alternador de verdade, com as configurações abaixo."

#: prefs.js:95
msgid "Appearance"
msgstr "Aparência"

#: prefs.js:102
msgid "Highlight"
msgstr "Destaque"

#: prefs.js:103
msgid "Changes apply the next time the switcher opens."
msgstr "As mudanças valem a partir da próxima vez que o alternador abrir."

#: prefs.js:108
msgid "Custom color"
msgstr "Cor personalizada"

#: prefs.js:109
msgid "Use this color instead of the system accent color"
msgstr "Usar esta cor em vez da cor de destaque do sistema"

#: prefs.js:145
msgid "Opacity (%)"
msgstr "Opacidade (%)"

#: prefs.js:146
msgid "Lower values let the icons behind show through"
msgstr "Valores menores deixam ver os ícones por trás"

#: prefs.js:147
msgid "Corner radius (px)"
msgstr "Arredondamento dos cantos (px)"

#: prefs.js:148
msgid "Border width (px)"
msgstr "Espessura da borda (px)"

#: prefs.js:149
msgid "0 draws no border"
msgstr "0 não desenha borda"

#: prefs.js:150
msgid "Selected item size (%)"
msgstr "Tamanho do item selecionado (%)"

#: prefs.js:151
msgid "100 turns the growth off"
msgstr "100 desliga o aumento"

#: prefs.js:156
msgid "Animation"
msgstr "Animação"

#: prefs.js:163
msgid "Transition"
msgstr "Transição"

#: prefs.js:164
msgid ""
"How the highlight moves when another item is selected. It follows GNOME's "
"Animations setting: with animations off, it jumps."
msgstr ""
"Como o destaque se move quando outro item é selecionado. Segue a opção "
"Animações do GNOME: com as animações desligadas, ele salta."

#: prefs.js:167
msgid "Style"
msgstr "Estilo"

#: prefs.js:168
msgid "Slide"
msgstr "Deslizar"

#: prefs.js:169
msgid "Stretch"
msgstr "Esticar"

#: prefs.js:170
msgid "Liquid"
msgstr "Líquido"

#: prefs.js:171
msgid "Jelly"
msgstr "Gelatina"

#: prefs.js:172
msgid "Pop"
msgstr "Pop"

#: prefs.js:173
msgid "Fade"
msgstr "Esmaecer"

#: prefs.js:174
msgid "None"
msgstr "Nenhuma"

#: prefs.js:176
msgid "Duration (ms)"
msgstr "Duração (ms)"

#: prefs.js:177
msgid "Curve"
msgstr "Curva"

#: prefs.js:178
msgid "Smooth"
msgstr "Suave"

#: prefs.js:179
msgid "Overshoot"
msgstr "Ultrapassar"

#: prefs.js:180
msgid "Bounce"
msgstr "Quicar"

#: prefs.js:181
msgid "Elastic"
msgstr "Elástica"

#: prefs.js:182
msgid "Linear"
msgstr "Linear"

#: prefs.js:184
msgid "Rebound (%)"
msgstr "Rebote (%)"

#: prefs.js:185
msgid "How far the curve goes past the item, or how high it bounces"
msgstr "Quanto a curva passa do item, ou a altura dos quiques"

#: prefs.js:188
msgid "Fine-tuning"
msgstr "Ajuste fino"

#: prefs.js:191
msgid "Time stretched over both items (%)"
msgstr "Tempo esticado sobre os dois itens (%)"

#: prefs.js:192
msgid "How liquid (%)"
msgstr "O quão líquido (%)"

#: prefs.js:193
msgid "Higher pulls the drop longer, with a thinner tail and neck"
msgstr "Mais alto estica mais a gota, com cauda e pescoço mais finos"

#: prefs.js:195
msgid "Bounce (%)"
msgstr "Rebote (%)"

#: prefs.js:196
msgid "How far it springs past the item"
msgstr "Quanto passa do item como mola"

#: prefs.js:197
msgid "Wobbles"
msgstr "Balanços"

#: prefs.js:198
msgid "How many times it swings before it settles"
msgstr "Quantas vezes balança antes de parar"

#: prefs.js:199
msgid "Stretch (%)"
msgstr "Estiramento (%)"

#: prefs.js:200
msgid "How much it stretches while moving fast"
msgstr "Quanto estica enquanto vai rápido"

#: prefs.js:202
msgid "Shrinks to (%)"
msgstr "Encolhe até (%)"

#: prefs.js:203
msgid "Size between the two items, relative to an item"
msgstr "Tamanho entre os dois itens, em relação a um item"

#: prefs.js:207
msgid "Moves to the next item in one motion"
msgstr "Vai até o próximo item em um só movimento"

#: prefs.js:208
msgid "Reaches over both items, then lets go"
msgstr "Estende-se sobre os dois itens e depois solta"

#: prefs.js:209
msgid "Flows like a drop, with a thin neck"
msgstr "Escorre como uma gota, com um pescoço fino"

#: prefs.js:210
msgid "Springs past the item and wobbles back"
msgstr "Passa do item como uma mola e volta balançando"

#: prefs.js:211
msgid "Shrinks, then grows out of the next item"
msgstr "Encolhe e depois brota do próximo item"

#: prefs.js:212
msgid "Fades out and back in on the next item"
msgstr "Some e reaparece no próximo item"

#: prefs.js:213
msgid "Jumps to the next item"
msgstr "Salta para o próximo item"

#: prefs.js:223
msgid "Not used by this style"
msgstr "Não usada por este estilo"

#: prefs.js:235
msgid "Reset All Settings"
msgstr "Restaurar todas as configurações"

#: prefs.js:239
msgid "Reset all settings?"
msgstr "Restaurar todas as configurações?"

#: prefs.js:240
msgid "Every option goes back to its default."
msgstr "Todas as opções voltam ao padrão."

#: prefs.js:244
msgid "Cancel"
msgstr "Cancelar"

#: prefs.js:245
msgid "Reset"
msgstr "Restaurar"
